{
  "name": "magomano-sacco",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node server/dev.js",
    "demo": "npm run build && wrangler d1 migrations apply magomano-db --local && node scripts/seed-demo.js && wrangler pages dev dist --local --port 8788",
    "dev:api": "wrangler pages dev dist --port 8788",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:demo:remote": "node scripts/seed-demo.js --remote",
    "deploy": "npm run build && wrangler pages deploy dist",
    "preview": "wrangler pages dev dist --port 8788"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^1.52.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.148.0"
  }
}
